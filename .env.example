APP_NAME="RVMI Media"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: http://localhost   Production: https://rvmi.deskcheque.top
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue workers on Namecheap — cron runs artisan schedule:run instead.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_STAGING_PREFIX=staging
AWS_MEDIA_PREFIX=media
AWS_INVENTORY_PREFIX=inventory

CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=
CLOUDFRONT_SIGNED_URL_TTL=600

REKOGNITION_ENABLED=true
REKOGNITION_FACE_COLLECTION_ID=rvmi-media-people
REKOGNITION_MIN_FACE_CONFIDENCE=80

GOOGLE_CLIENT_IDS=

FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=

# Retry batch for the 5-minute sweeper. Uploads are processed on complete().
MEDIA_PROCESS_BATCH_SIZE=8

VITE_APP_NAME="${APP_NAME}"
